#!/usr/bin/env bash
set -euo pipefail

vault="${OBSIDIAN_VAULT:-$HOME/Documents/Obsidian/MainVault}"
note="$vault/$(date +%Y-%m-%d).md"

mkdir -p "$(dirname "$note")"
if [[ ! -e "$note" ]]; then
    printf '# %s\n\n' "$(date '+%A, %-d %B %Y')" >"$note"
    printf '\n%.0s' {1..80} >>"$note"
fi
exec kitty --class orbit-notes -- micro -autosave 1 -softwrap true -clipboard terminal -statusline false -ruler false -colorscheme orbit-notes "$note"
