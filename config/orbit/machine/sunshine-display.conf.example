# Copy to ~/.config/orbit/machine/sunshine-display.conf and edit for this host.
# These values are intentionally machine-local and must not be committed.
ORBIT_SUNSHINE_PRIMARY_OUTPUT="PRIMARY_CONNECTOR"
ORBIT_SUNSHINE_SECONDARY_OUTPUT="SECONDARY_CONNECTOR"
ORBIT_SUNSHINE_GENERIC_PRIMARY_MODE="WIDTHxHEIGHT@REFRESH"
ORBIT_SUNSHINE_GENERIC_SECONDARY_MODE="WIDTHxHEIGHT@REFRESH"
ORBIT_SUNSHINE_GENERIC_SECONDARY_POSITION="XxY"
ORBIT_SUNSHINE_MAC_PRIMARY_MODE="WIDTHxHEIGHT@REFRESH"
ORBIT_SUNSHINE_MAC_SECONDARY_MODE="WIDTHxHEIGHT@REFRESH"
ORBIT_SUNSHINE_MAC_SECONDARY_POSITION="XxY"
